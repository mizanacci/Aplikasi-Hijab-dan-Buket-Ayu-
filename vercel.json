{
  "version": 2,
  "builds": [
    { "src": "index.php", "use": "@vercel/php" },
    { "src": "api.php", "use": "@vercel/php" }
  ],
  "routes": [
    { "src": "/api.php", "dest": "/api.php" },
    { "src": "/", "dest": "/index.php" },
    { "src": "/(.*)", "dest": "/index.php" }
  ],
  "env": {
    "PHP_VERSION": "8.2"
  }
}
